# Copie ce fichier en .env pour le développement local (ne jamais committer .env)
# Port d'écoute (Railway le définit automatiquement, 8080 par défaut)
PORT=8080

# Base de données PostgreSQL — OBLIGATOIRE en production sur Railway
# Sur Railway : créez un service "PostgreSQL", puis dans les variables de
# l'application ajoutez : DATABASE_URL = ${{Postgres.DATABASE_URL}}
# En local sans DATABASE_URL, le serveur utilise un fichier JSON (data/store.json)
# pour l'aperçu / le développement. Voir README.md.
DATABASE_URL=postgres://user:password@host:5432/ma_liste_de_courses
